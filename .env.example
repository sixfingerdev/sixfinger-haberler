# SixFinger Haberler API Configuration

# Flask Configuration
SECRET_KEY=sixfinger-dev-secret-key-2024-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/haberler
DATABASE_URL=sqlite:///haberler.db

# SixFinger API Configuration
API_USERNAME=your_api_username_here
API_PASSWORD=your_api_password_here

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
